#!/usr/bin/env bash
#
# deck-run <TaskID> | deck-run --no-task — spawn primitive (UI-agnostico) di loom-deck.
#
# Apre una tab di terminale nella finestra attiva e vi avvia una sessione Claude
# Code: Ptyxis su Linux, Windows Terminal su Windows. Argomenti, regole e
# messaggi: `deck-run` senza argomenti stampa l'uso.
#
# T176 — la composizione è TypeScript (`src/tab-args.ts`, `src/tab-compose.ts`,
# `src/tab-launch.ts`), una sola per le due piattaforme. Questo file resta allo
# stesso path, eseguibile, come shim: compass lo risolve come
# `<cli>/../scripts/deck-run` e ne controlla l'eseguibilità prima di lanciarlo, e
# `test/deck-run.test.ts` lo esegue a scatola chiusa come gate di parità.
# Esegue il BUILD (`dist/`), come il bin del pacchetto.
exec node "$(dirname "${BASH_SOURCE[0]}")/../dist/deck-run.js" "$@"
